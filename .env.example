# Copie para .env e preencha com os valores do seu projeto Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Branding / white-label (uma conta por cliente) ---------------------
# Personalize estas variaveis para cada instalacao/cliente do produto.
# Nenhuma delas e obrigatoria — o app cai em valores padrao (marca generica)
# se voce nao preencher.
# IMPORTANTE: valores com # (como cores hexadecimais) devem ficar entre aspas,
# senao tudo depois do # e tratado como comentario e ignorado.
VITE_APP_NAME=TerapiaViva
VITE_THERAPIST_NAME=
VITE_CITY=
VITE_CHURCH=
# Tradicao/linha de aconselhamento exibida na tela de login (texto livre)
VITE_TRADITION_LABEL=Terapia com base biblica
# Versiculo/frase de efeito na tela de login
VITE_LOGIN_VERSE="Sarei-vos das vossas feridas." — Jeremias 30:17
# Caminho da foto de capa do Dashboard (coloque o arquivo em public/ e aponte aqui)
VITE_HERO_PHOTO=/foto.jpg
# Cor tema (usada no theme-color do navegador mobile) — mantenha entre aspas
VITE_THEME_COLOR="#1D9E75"

# --- Somente para as Edge Functions (nao expor no front) -----------------
# Configurar via CLI, nunca aqui:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-api03-...
#   supabase secrets set ALLOWED_ORIGINS=https://app.seudominio.com
#   supabase secrets set THERAPY_TRADITION_LABEL="Terapeuta Biblica Crista (tradicao batista)"
#   supabase secrets set COUNSELING_TRAINING="TCC, ACT, trauma, apego, aconselhamento biblico noutetico, teologia pastoral batista"
#
# --- Cobranca via Mercado Pago (opcional — sem isso, o app funciona normalmente,
#     so o botao "Assinar" na tela de Configuracoes fica desabilitado) --------
#   supabase secrets set MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
#   supabase secrets set MP_PLAN_PRICE=97.00
#   supabase secrets set MP_PLAN_AI_LIMIT=300
#   supabase secrets set MP_BACK_URL=https://app.seudominio.com/config
# Configure tambem, no painel do Mercado Pago, a URL de webhook:
#   https://SEU-PROJETO.supabase.co/functions/v1/mercadopago-webhook
